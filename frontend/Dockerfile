FROM node:24-alpine

WORKDIR /app
ARG VITE_API_URL=http://localhost:8000
ARG VITE_INSTITUTION_NAME="CAMPUSINTEL demonstration workspace"
ARG VITE_SUPPORT_EMAIL=
ARG VITE_PRIVACY_URL=
ARG VITE_DEMO_MODE=true
ARG VITE_PASSWORD_RESET_ENABLED=true
ARG VITE_EMAIL_PREVIEW_URL=http://localhost:8025
ARG VITE_PASSWORD_RESET_EXPIRE_MINUTES=30
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_INSTITUTION_NAME=$VITE_INSTITUTION_NAME
ENV VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL
ENV VITE_PRIVACY_URL=$VITE_PRIVACY_URL
ENV VITE_DEMO_MODE=$VITE_DEMO_MODE
ENV VITE_PASSWORD_RESET_ENABLED=$VITE_PASSWORD_RESET_ENABLED
ENV VITE_EMAIL_PREVIEW_URL=$VITE_EMAIL_PREVIEW_URL
ENV VITE_PASSWORD_RESET_EXPIRE_MINUTES=$VITE_PASSWORD_RESET_EXPIRE_MINUTES
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev"]
